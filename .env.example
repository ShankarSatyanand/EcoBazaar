# ==============================================================================
# EcoBazaar Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Populate with your local environment values.
# 3. NEVER commit your actual '.env' file or production credentials to version control.
# ==============================================================================

# Database Configuration
# Local MySQL database connection credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecobazaar
DB_USERNAME=root
DB_PASSWORD=your_mysql_database_password_here

# JWT (JSON Web Token) Security Configuration
# JWT_SECRET must be at least 256 bits (32 characters) for HMAC-SHA256 signing
# Generate a secure key (e.g., using: openssl rand -base64 32)
JWT_SECRET=your_secure_256_bit_jwt_secret_min_32_characters_here
JWT_EXPIRATION_MS=86400000

# Optional Initial Admin Account Provisioning
# If ADMIN_EMAIL or ADMIN_PASSWORD is left unset or blank, initial admin seeding is safely skipped.
ADMIN_EMAIL=admin@ecobazaar.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Server Configuration
SERVER_PORT=8080
FRONTEND_PORT=5500
