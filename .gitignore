# ==============================================================================
# EcoBazaar Root .gitignore
# ==============================================================================

# Environment & Secret Configuration
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Node / Frontend Dependencies & Cache
node_modules/
frontend/node_modules/
.pnp
.pnp.js
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven Build Outputs
target/
backend/target/
build/
dist/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
HELP.md
.mvn/wrapper/maven-wrapper.jar

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
*.tmp
*.bak

# IDE & Editor Specific Files
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Dd]esktop.ini
